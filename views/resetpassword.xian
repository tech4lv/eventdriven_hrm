{{> head}}
<body class="bg-slate-950 text-slate-800 antialiased">
  <div class="min-h-screen flex items-center justify-center p-6">
    <div
      class="
        w-full
        max-w-md
        rounded-2xl
        border
        border-slate-700
        bg-slate-900
        p-6
        shadow-2xl
        shadow-slate-950/40
        sm:p-8
      "
    >
      <div class="mb-6 flex items-center justify-center gap-3">
        <div
          class="
            w-11
            h-11
            rounded-xl
            bg-blue-600
            text-white
            font-black
            grid
            place-items-center
          "
        >
          RB
        </div>
        <div class="text-center">
          <div class="text-white font-bold text-xl">RektaBuild</div>
          <div class="text-[11px] text-blue-300 uppercase tracking-[0.25em]">
            Human Resources
          </div>
        </div>
      </div>

      {{#if (eq mode "sent")}}
        <div class="text-center mb-6">
          <h2 class="text-2xl font-black text-white">Check your email</h2>
          <p class="mt-2 text-sm text-slate-400">
            If an account exists for that email, a reset link has been sent. It expires in 30 minutes.
          </p>
        </div>
      {{else}}
        {{#if (eq mode "issued")}}
          <div class="text-center mb-6">
            <h2 class="text-2xl font-black text-white">Reset link ready</h2>
            <p class="mt-2 text-sm text-slate-400">
              A reset link was generated for
              <b class="text-slate-200"
              >{{ email }}</b>. It expires in 30 minutes.
            </p>
          </div>
          <div class="rounded-xl border border-blue-500/30 bg-blue-500/10 p-4">
            <div
              class="text-[11px] uppercase tracking-widest text-blue-300 mb-2"
            >
              Demo mode — no email configured
            </div>
            <a
              class="break-all text-sm font-semibold text-blue-300 hover:underline"
              href="{{ link }}"
            >{{ link }}</a>
          </div>
          <p class="mt-4 text-xs text-slate-500">
            In production this link would be sent to the user's email instead of being displayed.
          </p>
        {{else}}
          {{#if (eq mode "form")}}
            <div class="text-center mb-6">
              <h2 class="text-2xl font-black text-white">
                Choose a new password
              </h2>
            </div>
            {{#each error_msg}}
              <div
                class="
                  mb-4
                  rounded-lg
                  border
                  border-red-500/40
                  bg-red-500/10
                  text-red-300
                  px-4
                  py-3
                  text-sm
                "
              >
                ⚠ {{ this }}
              </div>
            {{/each}}
            <form class="space-y-4" method="POST" action="/reset-password">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <input type="hidden" name="token" value="{{ token }}" />
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-2"
                >New password</label>
                <input
                  class="
                    w-full
                    rounded-xl
                    border
                    border-slate-700
                    bg-slate-800
                    px-3.5
                    py-3
                    text-sm
                    text-white
                    placeholder:text-slate-400
                    focus:outline-none
                    focus:ring-2
                    focus:ring-blue-500
                    focus:border-blue-500
                    transition
                  "
                  type="password"
                  name="password"
                  placeholder="••••••••"
                  autocomplete="new-password"
                  minlength="8"
                  required
                />
                <p class="mt-1.5 text-[11px] text-slate-500">
                  Min. 8 characters with an uppercase letter, a lowercase letter, a number, and a special character.
                </p>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-2"
                >Confirm new password</label>
                <input
                  class="
                    w-full
                    rounded-xl
                    border
                    border-slate-700
                    bg-slate-800
                    px-3.5
                    py-3
                    text-sm
                    text-white
                    placeholder:text-slate-400
                    focus:outline-none
                    focus:ring-2
                    focus:ring-blue-500
                    focus:border-blue-500
                    transition
                  "
                  type="password"
                  name="confirmPassword"
                  placeholder="••••••••"
                  autocomplete="new-password"
                  minlength="8"
                  required
                />
              </div>
              <button
                class="
                  w-full
                  rounded-xl
                  bg-blue-600
                  hover:bg-blue-500
                  text-white
                  font-bold
                  py-3
                  text-sm
                  shadow-lg
                  shadow-blue-500/25
                  transition
                "
                type="submit"
              >Reset password</button>
            </form>
          {{else}}
            <div class="text-center mb-6">
              <h2 class="text-2xl font-black text-white">Link expired</h2>
              <p class="mt-2 text-sm text-slate-400">
                This reset link is invalid or has expired. Please request a new one.
              </p>
            </div>
          {{/if}}
        {{/if}}
      {{/if}}

      <div class="mt-6 text-center">
        <a class="text-xs text-slate-400 hover:text-slate-300" href="/login"
        >&larr; Back to login</a>
      </div>
    </div>
  </div>
</body>
</html>
