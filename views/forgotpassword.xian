{{> head}}
<body class="bg-slate-950 text-slate-800 antialiased">
  <div class="min-h-screen flex items-center justify-center p-6">
    <div
      class="
        w-full
        max-w-md
        rounded-2xl
        border
        border-slate-700
        bg-slate-900
        p-6
        shadow-2xl
        shadow-slate-950/40
        sm:p-8
      "
    >
      <div class="mb-6 flex items-center justify-center gap-3">
        <div
          class="
            w-11
            h-11
            rounded-xl
            bg-blue-600
            text-white
            font-black
            grid
            place-items-center
          "
        >
          RB
        </div>
        <div class="text-center">
          <div class="text-white font-bold text-xl">RektaBuild</div>
          <div class="text-[11px] text-blue-300 uppercase tracking-[0.25em]">
            Human Resources
          </div>
        </div>
      </div>

      <div class="text-center mb-6">
        <h2 class="text-2xl font-black text-white">Forgot password?</h2>
        <p class="mt-2 text-sm text-slate-400">
          Enter your account email and we'll issue a reset link.
        </p>
      </div>

      {{#each error_msg}}
        <div
          class="
            mb-4
            rounded-lg
            border
            border-red-500/40
            bg-red-500/10
            text-red-300
            px-4
            py-3
            text-sm
          "
        >
          ⚠ {{ this }}
        </div>
      {{/each}}

      <form class="space-y-4" method="POST" action="/forgot-password">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-2"
          >Email</label>
          <input
            class="
              w-full
              rounded-xl
              border
              border-slate-700
              bg-slate-800
              px-3.5
              py-3
              text-sm
              text-white
              placeholder:text-slate-400
              focus:outline-none
              focus:ring-2
              focus:ring-blue-500
              focus:border-blue-500
              transition
            "
            type="email"
            name="email"
            placeholder="you@company.com"
            autocomplete="email"
            required
          />
        </div>
        <button
          class="
            w-full
            rounded-xl
            bg-blue-600
            hover:bg-blue-500
            text-white
            font-bold
            py-3
            text-sm
            shadow-lg
            shadow-blue-500/25
            transition
          "
          type="submit"
        >Send reset link</button>
      </form>

      <div class="mt-6 text-center">
        <a class="text-xs text-slate-400 hover:text-slate-300" href="/login"
        >&larr; Back to login</a>
      </div>
    </div>
  </div>
</body>
</html>
