{{> hrm-open}}
<div class="flex flex-wrap justify-between items-center gap-3 mb-4">
  <p class="text-sm text-slate-500">
    Assign workers to construction projects and sites, and monitor who is deployed where.
  </p>
  <button
    class="btn-primary"
    data-modal="asgModal"
    data-action="/hrm/assignments"
    data-heading="Assign employee"
    data-record='{"startDate":"{{ today }}","status":"active"}'
  >＋ Assign employee</button>
</div>
{{#if byProject.length}}
  <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-3 mb-4">
    {{#each byProject}}<a
      class="card p-4 hover:border-amber-400 transition block"
      href="/hrm/assignments?q={{ projectName }}"
    >
      <div class="font-bold">{{ projectName }}</div>
      <div class="text-xs text-slate-500">
        {{#if siteName}}{{ siteName }}{{else}}No site set{{/if}}
      </div>
      <div class="mt-2 text-2xl font-black text-amber-600">
        {{ workers }}
        <span class="text-xs text-slate-400 font-normal">active worker(s)</span>
      </div>
    </a>{{/each}}
  </div>
{{/if}}
<form
  class="card p-4 mb-4 grid sm:grid-cols-2 lg:grid-cols-4 gap-3"
  method="GET"
>
  <input
    class="inp"
    name="q"
    value="{{ q }}"
    placeholder="Search project or site…"
  />
  <select class="inp" name="status" data-autosubmit>
    <option value="">All statuses</option>
    <option
      value="active"
      {{sel status "active"}}
    >
      Active
    </option>
    <option
      value="completed"
      {{sel status "completed"}}
    >
      Completed
    </option>
    <option
      value="cancelled"
      {{sel status "cancelled"}}
    >
      Cancelled
    </option>
  </select>
  <select class="inp" name="employeeId" data-autosubmit>
    <option value="">All employees</option>
    {{#each employees}}
      <option
        value="{{ id }}"
        {{sel id ../employeeId}}
      >
        {{ fullName }}
      </option>
    {{/each}}
  </select>
  <button class="btn-ghost">Search</button>
</form>
<div class="card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="tbl">
      <thead>
        <tr>
          <th>Employee</th>
          <th>Project</th>
          <th>Site</th>
          <th>Role</th>
          <th>Period</th>
          <th>Status</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
          <tr>
            <td>
              <a
                class="font-semibold hover:text-amber-700"
                href="/hrm/employees/{{ employee.id }}"
              >{{ employee.fullName }}</a>
              <div class="text-xs text-slate-400">
                {{#if employee.department}}{{ employee.department.name }}{{/if}}
              </div>
            </td>
            <td>{{ projectName }}</td>
            <td>{{#if siteName}}{{ siteName }}{{else}}—{{/if}}</td>
            <td>{{#if roleOnProject}}{{ roleOnProject }}{{else}}—{{/if}}</td>
            <td class="whitespace-nowrap">
              {{fmtDate startDate}} →
              {{#if endDate}}{{fmtDate endDate}}{{else}}ongoing{{/if}}
            </td>
            <td>{{badge status}}</td>
            <td class="text-right whitespace-nowrap">
              <button
                class="btn-ghost btn-sm"
                data-modal="asgModal"
                data-action="/hrm/assignments/{{ id }}"
                data-heading="Edit assignment"
                data-record="{{json this}}"
              >Edit</button>
              {{#if (eq status "active")}}
                <form
                  class="inline"
                  method="POST"
                  action="/hrm/assignments/{{ id }}/end"
                  data-title="End assignment"
                  data-btn="End assignment"
                  data-confirm="End {{ employee.fullName }}’s assignment to {{ projectName }} today?"
                >
                  {{> hrm-csrf}}<button class="btn-ghost btn-sm">End</button>
                </form>
              {{/if}}
              <form
                class="inline"
                method="POST"
                action="/hrm/assignments/{{ id }}/delete"
                data-title="Delete assignment"
                data-btn="Delete"
                data-confirm="Delete this assignment record permanently?"
              >
                {{> hrm-csrf}}<button class="btn-danger btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        {{else}}
          <tr>
            <td class="text-center text-slate-400 py-10" colspan="7">
              No assignments found.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<div
  id="asgModal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
>
  <div class="card w-full max-w-lg p-6">
    <h3 class="font-bold text-lg mb-4" data-title>Assignment</h3>
    <form class="space-y-3" method="POST" action="/hrm/assignments">
      {{> hrm-csrf}}
      <div>
        <label class="lbl">Employee *</label>
        <select class="inp" name="employeeId" required>
          <option value="">Select…</option>
          {{#each employees}}
            <option value="{{ id }}">{{ fullName }} ({{ employeeNo }})</option>
          {{/each}}
        </select>
        <p class="text-xs text-slate-400 mt-1">
          When editing, the employee cannot be changed — end the assignment and create a new one.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="lbl">Project *</label>
          <input class="inp" name="projectName" list="projList" required />
          <datalist id="projList">
            {{#each projects}}
              <option value="{{this}}">
            {{/each}}
          </datalist>
        </div>
        <div>
          <label class="lbl">Construction site</label>
          <input class="inp" name="siteName" list="siteList" />
          <datalist id="siteList">
            {{#each sites}}
              <option value="{{this}}">
            {{/each}}
          </datalist>
        </div>
      </div>
      <div>
        <label class="lbl">Role on project</label>
        <input
          class="inp"
          name="roleOnProject"
          placeholder="e.g. Mason, Foreman"
        />
      </div>
      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="lbl">Start *</label>
          <input class="inp" type="date" name="startDate" required />
        </div>
        <div>
          <label class="lbl">End</label>
          <input class="inp" type="date" name="endDate" />
        </div>
        <div>
          <label class="lbl">Status</label>
          <select class="inp" name="status">
            <option value="active">Active</option>
            <option value="completed">Completed</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
      </div>
      <div>
        <label class="lbl">Notes</label>
        <input class="inp" name="notes" maxlength="255" />
      </div>
      <div class="flex justify-end gap-2">
        <button class="btn-ghost" type="button" data-close
        >Cancel</button><button class="btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>
{{> hrm-close}}
