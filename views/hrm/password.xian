{{> hrm-open}}
<div class="max-w-md mx-auto">
  <div class="card p-6">
    <h2 class="font-bold text-lg mb-1">Change password</h2>
    <p class="text-sm text-slate-500 mb-5">
      Use at least 8 characters with an uppercase letter, a lowercase letter, a number, and a special character.
    </p>
    <form class="space-y-4" method="POST" action="/hrm/me/password">
      {{> hrm-csrf}}
      <div>
        <label class="lbl">Current password</label>
        <input
          class="inp"
          type="password"
          name="currentPassword"
          autocomplete="current-password"
          required
        />
      </div>
      <div>
        <label class="lbl">New password</label>
        <input
          class="inp"
          type="password"
          name="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
      </div>
      <div>
        <label class="lbl">Confirm new password</label>
        <input
          class="inp"
          type="password"
          name="confirmPassword"
          autocomplete="new-password"
          minlength="8"
          required
        />
      </div>
      <div class="flex gap-2 justify-end pt-2">
        <a
          class="btn-ghost"
          href="{{#if isHR}}/hrm{{else}}/hrm/me{{/if}}"
        >Cancel</a>
        <button class="btn-primary">Update password</button>
      </div>
    </form>
  </div>
</div>
{{> hrm-close}}
