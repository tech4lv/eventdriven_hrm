{{> hrm-open}}
<div class="card p-4 mb-4 flex flex-wrap items-end justify-between gap-3">
  <form class="flex flex-wrap items-end gap-3" method="GET">
    {{#if isHR}}
      <div>
        <label class="lbl">Employee</label>
        <select class="inp" name="employeeId" data-autosubmit>
          {{#each employees}}
            <option
              value="{{ id }}"
              {{sel id ../employee.id}}
            >
              {{ fullName }} ({{ employeeNo }})
            </option>
          {{/each}}
        </select>
      </div>
    {{/if}}
    <input type="hidden" name="month" value="{{ month }}" />
  </form>
  <div class="flex items-center gap-2">
    <a class="btn-ghost" href="?employeeId={{ employee.id }}&month={{ prev }}"
    >‹</a>
    <div class="font-bold w-40 text-center">{{ monthLabel }}</div>
    <a class="btn-ghost" href="?employeeId={{ employee.id }}&month={{ next }}"
    >›</a>
  </div>
</div>
<div class="grid lg:grid-cols-3 gap-4">
  <div class="card p-4 lg:col-span-2">
    <div class="mb-3 font-bold">
      {{ employee.fullName }}
      <span class="text-slate-400 font-normal text-sm"
      >{{ employee.employeeNo }}</span>
    </div>
    <div
      class="grid grid-cols-7 text-center text-xs font-semibold text-slate-400 mb-1"
    >
      <div>Sun</div>
      <div>Mon</div>
      <div>Tue</div>
      <div>Wed</div>
      <div>Thu</div>
      <div>Fri</div>
      <div>Sat</div>
    </div>
    {{#each weeks}}
      <div class="grid grid-cols-7 gap-1 mb-1">
        {{#each this}}
          {{#if this}}
            <div
              class="min-h-[4.5rem]
                rounded-lg
                border
                p-1.5
                text-xs
                {{#if isToday}}
                  border-amber-500
                  ring-1
                  ring-amber-400
                {{else}}
                  border-slate-200
                {{/if}}
                {{calCell status}}
              "
            >
              <div class="font-bold">{{ day }}</div>
              {{#if record}}
                <div class="mt-0.5 leading-tight">
                  {{#if record.timeIn}}{{fmtTime record.timeIn}}{{else}}{{statusLabel status}}{{/if}}
                </div>
                {{#if record.timeOut}}
                  <div class="leading-tight opacity-70">
                    {{fmtTime record.timeOut}}
                  </div>
                {{/if}}
              {{/if}}
            </div>
          {{else}}
            <div></div>
          {{/if}}
        {{/each}}
      </div>
    {{/each}}
    <div class="flex flex-wrap gap-3 mt-3 text-xs text-slate-500">
      <span><i class="inline-block w-3 h-3 rounded bg-emerald-200"></i> Present</span><span><i
          class="inline-block w-3 h-3 rounded bg-amber-200"
        ></i>
        Late</span><span><i class="inline-block w-3 h-3 rounded bg-red-200"></i>
        Absent</span><span><i class="inline-block w-3 h-3 rounded bg-sky-200"
        ></i>
        On leave</span>
    </div>
  </div>
  <div class="space-y-4">
    <div class="card p-5">
      <h3 class="font-bold mb-3">Month summary</h3>
      <div class="grid grid-cols-2 gap-3 text-center">
        <div class="rounded-lg bg-emerald-50 p-3">
          <div class="text-2xl font-black text-emerald-600">
            {{ summary.daysPresent }}
          </div>
          <div class="text-xs text-slate-500">Present</div>
        </div>
        <div class="rounded-lg bg-amber-50 p-3">
          <div class="text-2xl font-black text-amber-600">
            {{ summary.daysLate }}
          </div>
          <div class="text-xs text-slate-500">Late</div>
        </div>
        <div class="rounded-lg bg-red-50 p-3">
          <div class="text-2xl font-black text-red-600">
            {{ summary.daysAbsent }}
          </div>
          <div class="text-xs text-slate-500">Absent (recorded)</div>
        </div>
        <div class="rounded-lg bg-sky-50 p-3">
          <div class="text-2xl font-black text-sky-600">
            {{ summary.daysOnLeave }}
          </div>
          <div class="text-xs text-slate-500">On leave</div>
        </div>
      </div>
      <p class="text-xs text-slate-500 mt-3">
        Hours worked: <b>{{ summary.hoursWorked }}</b> · Minutes late:
        <b>{{ summary.minutesLate }}</b>
      </p>
    </div>
    <div class="card overflow-hidden">
      <div class="px-5 py-3 font-bold">History</div>
      <div class="max-h-80 overflow-auto">
        <table class="tbl">
          <thead>
            <tr>
              <th>Date</th>
              <th>In / Out</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {{#each history}}
              <tr>
                <td class="whitespace-nowrap">{{fmtDate date}}</td>
                <td class="whitespace-nowrap text-xs">
                  {{fmtTime timeIn}} – {{fmtTime timeOut}}
                </td>
                <td>{{badge status}}</td>
              </tr>
            {{else}}
              <tr>
                <td class="text-center text-slate-400 py-6" colspan="3">
                  No records.
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{{> hrm-close}}
