{{> hrm-open}}
<div class="card max-w-lg mx-auto p-8 text-center">
  <div class="text-5xl mb-3">⛔</div>
  <h2 class="text-xl font-bold mb-2">Access denied</h2>
  <p class="text-slate-600 text-sm mb-5">
    Your account does not have permission to view this page, or it is not linked to an employee record. Please contact HR if you think this is a mistake.
  </p>
  <a class="btn-primary" href="/">Back to RektaBuild</a>
</div>
{{> hrm-close}}
