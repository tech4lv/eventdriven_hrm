{{> hrm-open}}
<div class="card max-w-lg mx-auto p-8 text-center">
  <div class="text-5xl mb-3">🛠️</div>
  <h2 class="text-xl font-bold mb-2">Something went wrong</h2>
  <p class="text-slate-600 text-sm mb-5">{{ message }}</p>
  <a class="btn-primary" href="/hrm">Back to HRM</a>
</div>
{{> hrm-close}}
