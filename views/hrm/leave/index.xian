{{> hrm-open}}
<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
  <div class="flex gap-2 text-sm">
    <span
      class="rounded-full bg-amber-100 text-amber-800 font-semibold px-3 py-1"
    >{{ pending }} pending</span>
  </div>
  {{#if canApply}}<button class="btn-primary" data-modal="applyModal"
  >＋ Apply for leave</button>{{/if}}
</div>
<form
  class="card p-4 mb-4 grid sm:grid-cols-2 lg:grid-cols-5 gap-3"
  method="GET"
>
  <select class="inp" name="status" data-autosubmit>
    <option value="">All statuses</option>
    {{#each (list "pending" "approved" "rejected" "cancelled")}}
      <option
        value="{{ this }}"
        {{sel this ../status}}
      >
        {{ this }}
      </option>
    {{/each}}
  </select>
  <select class="inp" name="leaveTypeId" data-autosubmit>
    <option value="">All leave types</option>
    {{#each types}}
      <option
        value="{{ id }}"
        {{sel id ../leaveTypeId}}
      >
        {{ name }}
      </option>
    {{/each}}
  </select>
  {{#if isHR}}
    <select class="inp" name="employeeId" data-autosubmit>
      <option value="">All employees</option>
      {{#each employees}}
        <option
          value="{{ id }}"
          {{sel id ../employeeId}}
        >
          {{ fullName }}
        </option>
      {{/each}}
    </select>
  {{/if}}
  <input
    class="inp"
    type="number"
    name="year"
    value="{{ year }}"
    min="2020"
    max="2100"
    data-autosubmit
  />
</form>
<div class="card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="tbl">
      <thead>
        <tr>
          <th>Employee</th>
          <th>Type</th>
          <th>Dates</th>
          <th>Days</th>
          <th>Reason</th>
          <th>Status</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
          <tr>
            <td>
              <div class="font-semibold">{{ employee.fullName }}</div>
              <div class="text-xs text-slate-400">
                {{#if employee.department}}{{ employee.department.name }}{{/if}}
              </div>
            </td>
            <td>{{ leaveType.name }}</td>
            <td class="whitespace-nowrap">
              {{fmtDate startDate}}{{#unless (eq startDate endDate)}} – {{fmtDate endDate}}{{/unless}}
            </td>
            <td>{{num days}}</td>
            <td class="max-w-[14rem] text-slate-500">{{ reason }}</td>
            <td>
              {{badge status}}
              {{#if reviewRemarks}}
                <div class="text-xs text-slate-400 mt-1">
                  “{{ reviewRemarks }}”
                </div>
              {{/if}}
              {{#if reviewer}}
                <div class="text-[11px] text-slate-400">
                  by {{ reviewer.name }}
                </div>
              {{/if}}
            </td>
            <td class="text-right whitespace-nowrap">
              {{#if @root.isHR}}
                {{#if (eq status "pending")}}
                  <form
                    class="inline"
                    method="POST"
                    action="/hrm/leave/{{ id }}/approve"
                    data-title="Approve leave"
                    data-btn="Approve"
                    data-confirm="Approve {{num days}} day(s) of {{ leaveType.name }} for {{ employee.fullName }}? The balance and attendance calendar will be updated."
                  >
                    {{> hrm-csrf}}<button class="btn-primary btn-sm"
                    >Approve</button>
                  </form>
                  <button
                    class="btn-danger btn-sm"
                    data-modal="rejectModal"
                    data-action="/hrm/leave/{{ id }}/reject"
                  >Reject</button>
                {{/if}}
              {{/if}}
              {{#if canCancel}}
                <form
                  class="inline"
                  method="POST"
                  action="/hrm/leave/{{ id }}/cancel"
                  data-title="Cancel leave request"
                  data-btn="Cancel request"
                  data-confirm="Cancel this {{ leaveType.name }} request?{{#if (eq status 'approved')}}The used balance will be returned.{{/if}}"
                >
                  {{> hrm-csrf}}<button class="btn-ghost btn-sm">Cancel</button>
                </form>
              {{/if}}
            </td>
          </tr>
        {{else}}
          <tr>
            <td class="text-center text-slate-400 py-10" colspan="7">
              No leave requests found.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<div
  id="applyModal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
>
  <div class="card w-full max-w-md p-6">
    <h3 class="font-bold text-lg mb-4">Leave application</h3>
    <form class="space-y-3" method="POST" action="/hrm/leave">
      {{> hrm-csrf}}
      {{#if isHR}}
        <div>
          <label class="lbl">Employee</label>
          <select class="inp" name="employeeId" required>
            {{#each employees}}
              <option
                value="{{ id }}"
                {{sel id @root.me.employeeId}}
              >
                {{ fullName }}
              </option>
            {{/each}}
          </select>
        </div>
      {{/if}}
      <div>
        <label class="lbl">Leave type</label>
        <select class="inp" name="leaveTypeId" required>
          {{#each types}}
            <option value="{{ id }}">
              {{ name }}{{#if isPaid}} ({{num defaultDays}} days/yr){{else}} (unpaid){{/if}}
            </option>
          {{/each}}
        </select>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="lbl">From</label>
          <input
            class="inp"
            type="date"
            name="startDate"
            min="{{ today }}"
            required
          />
        </div>
        <div>
          <label class="lbl">To</label>
          <input
            class="inp"
            type="date"
            name="endDate"
            min="{{ today }}"
            required
          />
        </div>
      </div>
      <div>
        <label class="lbl">Reason</label>
        <textarea class="inp" name="reason" rows="3" maxlength="500"></textarea>
      </div>
      <p class="text-xs text-slate-400">
        Days are counted on your scheduled working days only.
      </p>
      <div class="flex justify-end gap-2">
        <button class="btn-ghost" type="button" data-close
        >Cancel</button><button class="btn-primary">Submit</button>
      </div>
    </form>
  </div>
</div>

<div
  id="rejectModal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
>
  <div class="card w-full max-w-sm p-6">
    <h3 class="font-bold text-lg mb-2">Reject leave request</h3>
    <form class="space-y-3" method="POST" action="#">
      {{> hrm-csrf}}
      <div>
        <label class="lbl">Reason for rejection (shown to the employee)</label>
        <textarea class="inp" name="remarks" rows="3" maxlength="255"
        ></textarea>
      </div>
      <div class="flex justify-end gap-2">
        <button class="btn-ghost" type="button" data-close>Back</button><button
          class="btn-danger"
        >Reject</button>
      </div>
    </form>
  </div>
</div>
{{> hrm-close}}
