{{> hrm-open}}
<div class="flex justify-between items-center mb-4">
  <p class="text-sm text-slate-500">
    Leave types and their yearly entitlements.
  </p>
  <button
    class="btn-primary"
    data-modal="typeModal"
    data-action="/hrm/leave/types"
    data-heading="Add leave type"
  >＋ Add leave type</button>
</div>
<div class="card overflow-hidden">
  <table class="tbl">
    <thead>
      <tr>
        <th>Name</th>
        <th>Days / year</th>
        <th>Paid</th>
        <th>Status</th>
        <th class="text-right">Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
        <tr>
          <td>
            <div class="font-semibold">{{ name }}</div>
            <div class="text-xs text-slate-400">{{ description }}</div>
          </td>
          <td>{{#if isPaid}}{{num defaultDays}}{{else}}—{{/if}}</td>
          <td>{{#if isPaid}}{{badge "yes"}}{{else}}{{badge "no"}}{{/if}}</td>
          <td>
            {{#if isActive}}{{badge "active"}}{{else}}{{badge "inactive"}}{{/if}}
          </td>
          <td class="text-right whitespace-nowrap">
            <button
              class="btn-ghost btn-sm"
              data-modal="typeModal"
              data-action="/hrm/leave/types/{{ id }}"
              data-heading="Edit leave type"
              data-record="{{json this}}"
            >Edit</button>
            <form
              class="inline"
              method="POST"
              action="/hrm/leave/types/{{ id }}/delete"
              data-title="Delete leave type"
              data-btn="Delete"
              data-confirm="Delete “{{ name }}”? Types already used in requests cannot be deleted — set them inactive instead."
            >
              {{> hrm-csrf}}<button class="btn-danger btn-sm">Delete</button>
            </form>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>
<div
  id="typeModal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
>
  <div class="card w-full max-w-md p-6">
    <h3 class="font-bold text-lg mb-4" data-title>Leave type</h3>
    <form class="space-y-3" method="POST" action="/hrm/leave/types">
      {{> hrm-csrf}}
      <div>
        <label class="lbl">Name *</label>
        <input class="inp" name="name" required />
      </div>
      <div>
        <label class="lbl">Description</label>
        <input class="inp" name="description" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="lbl">Days per year</label>
          <input
            class="inp"
            type="number"
            step="0.5"
            min="0"
            name="defaultDays"
            value="0"
          />
        </div>
        <div>
          <label class="lbl">Paid?</label>
          <select class="inp" name="isPaid">
            <option value="1">Paid (tracked)</option>
            <option value="0">Unpaid (no limit)</option>
          </select>
        </div>
      </div>
      <div>
        <label class="lbl">Status</label>
        <select class="inp" name="isActive">
          <option value="1">Active</option>
          <option value="0">Inactive</option>
        </select>
      </div>
      <div class="flex justify-end gap-2">
        <button class="btn-ghost" type="button" data-close
        >Cancel</button><button class="btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>
{{> hrm-close}}
