{{> head}}
<body class="bg-slate-950 text-slate-800 antialiased">
  <div class="min-h-screen flex items-center justify-center p-6">
    <div
      class="
        w-full
        max-w-md
        rounded-2xl
        border
        border-slate-700
        bg-slate-900
        p-6
        shadow-2xl
        shadow-slate-950/40
        sm:p-8
        text-center
      "
    >
      <div
        class="
          mx-auto
          mb-6
          w-11
          h-11
          rounded-xl
          bg-amber-500
          text-white
          font-black
          grid
          place-items-center
        "
      >
        ⏳
      </div>
      <h2 class="text-2xl font-black text-white">Account pending</h2>
      <p class="mt-3 text-sm text-slate-400 leading-relaxed">
        Your account <b class="text-slate-200">{{ me.email }}</b>
        isn't linked to an active employee record yet. Please ask HR to link it from the employee form ("Linked RektaBuild user account") and make sure the record is active.
      </p>
      <div class="mt-6 flex justify-center gap-3">
        <form method="POST" action="/logout">
          <input type="hidden" name="_csrf" value="{{ csrf }}" />
          <button
            class="
              rounded-xl
              border
              border-slate-600
              px-5
              py-2.5
              text-sm
              font-semibold
              text-slate-300
              hover:bg-slate-800
              transition
              cursor-pointer
            "
            type="submit"
          >Logout</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
