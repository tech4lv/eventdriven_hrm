{{> head}}
<style type="text/tailwindcss">
  @layer components {
    .card { @apply bg-white rounded-xl border border-slate-200 shadow-sm; }
    .btn { @apply inline-flex items-center justify-center gap-2 rounded-lg px-3.5 py-2 text-sm font-semibold transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed; }
    .btn-primary { @apply inline-flex items-center justify-center gap-2 rounded-lg px-3.5 py-2 text-sm font-semibold transition cursor-pointer bg-blue-600 text-white hover:bg-blue-500 disabled:opacity-40 disabled:cursor-not-allowed; }
    .btn-ghost { @apply inline-flex items-center justify-center gap-2 rounded-lg px-3.5 py-2 text-sm font-semibold transition cursor-pointer border border-slate-300 bg-white text-slate-700 hover:bg-slate-50; }
    .btn-danger { @apply inline-flex items-center justify-center gap-2 rounded-lg px-3.5 py-2 text-sm font-semibold transition cursor-pointer bg-red-600 text-white hover:bg-red-500; }
    .btn-sm { @apply !px-2.5 !py-1 !text-xs; }
    .btn-lg { @apply !px-6 !py-3 !text-base; }
    .inp { @apply w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-blue-400; }
    .lbl { @apply block text-xs font-semibold text-slate-600 mb-1; }
    .tbl { @apply w-full text-sm; }
    .tbl th { @apply text-left text-xs uppercase tracking-wide text-slate-500 bg-blue-50 px-4 py-3 font-semibold whitespace-nowrap; }
    .tbl td { @apply px-4 py-3 border-t border-slate-100 align-middle; }
    .tbl tbody tr:hover { @apply bg-blue-50/40; }
  }
</style>
<body class="bg-slate-100 text-slate-800">
  <div id="overlay" class="fixed inset-0 bg-black/50 z-30 hidden md:hidden"
  ></div>
  <aside
    id="sidebar"
    class="
      fixed
      inset-y-0
      left-0
      z-40
      w-64
      -translate-x-full
      md:translate-x-0
      transition-transform
      bg-[#020d1d]
      text-slate-300
      flex
      flex-col
      shadow-2xl
      shadow-slate-900/20
    "
  >
    <div class="px-5 py-5 border-b border-slate-800 flex items-center gap-3">
      <div
        class="
          w-11
          h-11
          rounded-lg
          bg-blue-600
          text-white
          font-black
          grid
          place-items-center
          text-2xl
        "
      >
        RB
      </div>
      <div class="leading-tight">
        <div class="text-white font-bold text-[15px] leading-none">
          RektaBuild
        </div>
        <div class="mt-2 text-[11px] text-blue-300 uppercase tracking-[0.18em]">
          Human Resources
        </div>
      </div>
    </div>
    <nav class="flex-1 overflow-hidden p-2 text-sm">
      {{#if isHR}}
        <a
          class="
            {{navc
            active
            'dashboard'}}
            block
            rounded-lg
            px-3
            py-2.5
            text-[14px]
            font-semibold
            text-white
            bg-blue-600
          "
          href="/hrm"
        >Dashboard</a>
        <div
          class="px-3 pt-4 pb-1 text-[10px] uppercase tracking-[0.2em] text-slate-500"
        >
          People
        </div>
        <a
          class="{{navc active 'employees'}} block px-3 py-1.5 text-[14px] text-slate-200"
          href="/hrm/employees"
        >Employees</a>
        <a
          class="
            {{navc
            active
            'departments'}}
            block
            px-3
            py-1.5
            text-[14px]
            text-slate-200
          "
          href="/hrm/departments"
        >Departments</a>
        <a
          class="{{navc active 'positions'}} block px-3 py-1.5 text-[14px] text-slate-200"
          href="/hrm/positions"
        >Job Positions</a>
      {{else}}
    <a
      class="{{navc active 'profile'}} block px-3 py-2 text-[14px] text-slate-200"
      href="/hrm/me"
    >My Profile</a>
    {{/if}}
      <div
        class="px-3 pt-4 pb-1 text-[10px] uppercase tracking-[0.2em] text-slate-500"
      >
        Time &amp; Leave
      </div>
      <a
        class="
          {{navc
          active
          'attendance'}}
          block
          px-3
          py-1.5
          text-[14px]
          text-slate-200
        "
        href="/hrm/attendance"
      >Attendance</a>
      <a
        class="{{navc active 'calendar'}} block px-3 py-1.5 text-[14px] text-slate-200"
        href="/hrm/attendance/calendar"
      >Calendar</a>
      <a
        class="{{navc active 'leave'}} block px-3 py-1.5 text-[14px] text-slate-200"
        href="/hrm/leave"
      >Leave Requests</a>
      <a
        class="{{navc active 'balances'}} block px-3 py-1.5 text-[14px] text-slate-200"
        href="/hrm/leave/balances"
      >Leave Balances</a>
      {{#if isHR}}
        <a
          class="
            {{navc
            active
            'leavetypes'}}
            block
            px-3
            py-1.5
            text-[14px]
            text-slate-200
          "
          href="/hrm/leave/types"
        >Leave Types</a>
        <div
          class="px-3 pt-4 pb-1 text-[10px] uppercase tracking-[0.2em] text-slate-500"
        >
          Deployment
        </div>
        <a
          class="
            {{navc
            active
            'assignments'}}
            block
            px-3
            py-1.5
            text-[14px]
            text-slate-200
          "
          href="/hrm/assignments"
        >Project Assignments</a>
        <a
          class="{{navc active 'schedules'}} block px-3 py-1.5 text-[14px] text-slate-200"
          href="/hrm/schedules"
        >Work Schedules</a>
        <div
          class="px-3 pt-4 pb-1 text-[10px] uppercase tracking-[0.2em] text-slate-500"
        >
          Insights
        </div>
        <a
          class="{{navc active 'reports'}} block px-3 py-1.5 text-[14px] text-slate-200"
          href="/hrm/reports"
        >Reports</a>
        {{#if isAdmin}}<a
          class="{{navc active 'resignations'}} block px-3 py-1.5 text-[14px] text-slate-200"
          href="/hrm/resignations"
        >Resignations</a><a
          class="{{navc active 'users'}} block px-3 py-1.5 text-[14px] text-slate-200"
          href="/hrm/users"
        >User Accounts</a>{{/if}}
      {{/if}}
    </nav>
    <div class="p-3 border-t border-slate-800 text-sm">
      <div class="flex items-start justify-between gap-3">
        <div>
          <div class="text-white font-medium text-base truncate">
            {{ me.name }}
          </div>
          <div class="text-xs text-slate-400 truncate">{{ me.email }}</div>
        </div>
        <form class="inline" method="POST" action="/logout">
          <input type="hidden" name="_csrf" value="{{ @root.csrf }}" />
          <button
            class="text-xs text-slate-400 hover:text-white cursor-pointer"
            type="submit"
          >Logout</button>
        </form>
      </div>
    </div>
  </aside>
  <div class="md:ml-64 min-h-screen flex flex-col min-w-0">
    <header
      class="
        sticky
        top-0
        z-20
        bg-white/90
        backdrop-blur
        border-b
        border-slate-200
        px-4
        md:px-6
        h-14
        flex
        items-center
        gap-3
      "
    >
      <button
        id="menuBtn"
        class="md:hidden text-2xl leading-none"
        aria-label="Menu"
      >☰</button>
      <h1 class="font-bold text-lg truncate text-slate-900">{{ title }}</h1>
    </header>
    <main class="p-4 md:p-6 flex-1">
      {{#each success_msg}}
        <div
          class="
            mb-4
            rounded-lg
            border
            border-emerald-200
            bg-emerald-50
            text-emerald-800
            px-4
            py-3
            text-sm
          "
        >
          ✓ {{ this }}
        </div>
      {{/each}}
      {{#each error_msg}}
        <div
          class="
            mb-4
            rounded-lg
            border
            border-red-200
            bg-red-50
            text-red-800
            px-4
            py-3
            text-sm
          "
        >
          ⚠ {{ this }}
        </div>
      {{/each}}
