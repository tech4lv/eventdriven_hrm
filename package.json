{
  "name": "RektaBuild_HRM",
  "version": "1.0.0",
  "description": "XianFire Framework project",
  "main": "index.js",
  "type": "module",
  "bin": {
    "xian": "./bin/xian.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "xian": "nodemon index.js",
    "migrate": "node migrate.js",
    "create:model": "node create.js model",
    "create:controller": "node create.js controller",
    "create:add-middleware": "node create.js middleware",
    "create:upload-middleware": "node create.js upload-middleware",
    "route:list": "node list-routes.js",
    "route:cache": "node route-cache.js",
    "test": "node --test tests/hrmUtils.test.js tests/validators.test.js tests/csvSafety.test.js tests/migrationSafety.test.js tests/hrm.db.test.js",
    "hrm:migrate": "node models/hrm/migrate-hrm.js",
    "hrm:seed": "node models/hrm/seed-hrm.js",
    "format": "prettier --write \"controllers/**/*.js\" \"models/**/*.js\" \"middleware/**/*.js\" \"routes/**/*.js\" \"*.js\" && prettier --write --plugin=@poliklot/prettier-plugin-handlebars --parser handlebars \"views/**/*.xian\""
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "connect-flash": "^0.1.1",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "hbs": "^4.2.0",
    "inquirer": "^9.2.15",
    "multer": "^2.0.2",
    "mysql2": "^3.9.2",
    "nodemailer": "6.9.16",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@poliklot/prettier-plugin-handlebars": "^0.4.2",
    "nodemon": "^3.1.0",
    "prettier": "^3.10.1"
  }
}
