# ---- Server ----
NODE_ENV=development
PORT=5000
# Public base URL used in password-reset emails (required for real email delivery).
APP_BASE_URL=http://localhost:5000
# Set to true/1/hop-count only when behind a trusted reverse proxy.
TRUST_PROXY=
# Override secure cookies when needed (defaults to true in production).
COOKIE_SECURE=

# ---- Database (MySQL) ----
# Required when NODE_ENV=production.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=Rekta
DB_USER=root
DB_PASSWORD=
# Optional: enable only when MySQL requires SSL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Sessions ----
# REQUIRED in production (NODE_ENV=production), minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# memory = dev only (sessions lost on restart)
# mysql  = persisted in the `sessions` table (default when NODE_ENV=production)
SESSION_STORE=memory

# ---- Password reset email (optional) ----
# When SMTP_HOST is configured, reset links are emailed instead of displayed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Demo fallback only: show the reset link in the browser when SMTP is not
# configured. Defaults to true outside production and false in production.
PASSWORD_RESET_EXPOSE_LINK=

# ---- HRM API (/api/hrm) ----
# Shared secret for machine-to-machine access from other RektaBuild modules
# (Payroll, Accounting, Supply, Inventory). Send as `X-API-Key: <key>` or
# `Authorization: Bearer <key>`. When empty, only browser session auth works.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HRM_API_KEY=
